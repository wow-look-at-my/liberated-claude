<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy to config.xml and edit. ${VAR} is read from the environment at load;
  an unset variable is a startup error rather than an empty key.

  contextWindow is the attribute that matters most. It is advertised to Claude
  Desktop verbatim as max_input_tokens, and Desktop offers a 1M-context variant
  for any model at or above 1000000. Put the model's real capacity here.

  tier is required on every model. Claude Desktop discards any discovered model
  that neither carries a recognized tier (sonnet, opus, haiku, fable, mythos)
  nor has an Anthropic-looking ID.
-->
<liberatedClaude>
	<server>
		<listen>127.0.0.1:8787</listen>
		<publicURL>http://127.0.0.1:8787</publicURL>
		<apiKey>${LIBERATED_CLAUDE_KEY}</apiKey>
	</server>

	<bootstrap>
		<deploymentDisplayName>Liberated Claude</deploymentDisplayName>
		<chatTabEnabled>true</chatTabEnabled>
		<autoModeEnabled>true</autoModeEnabled>
		<toolSearchEnabled>true</toolSearchEnabled>
		<preferOneMContext>true</preferOneMContext>
		<disableTelemetry>true</disableTelemetry>
	</bootstrap>

	<providers>
		<!--
		  cache="explicit": the provider honors Anthropic cache_control blocks,
		  which are forwarded untouched.
		-->
		<provider name="anthropic" kind="anthropic" cache="explicit">
			<baseURL>https://api.anthropic.com</baseURL>
			<apiKey>${ANTHROPIC_API_KEY}</apiKey>
			<models>
				<!--
				  Only one model per tier should carry tierDefault; the
				  OpenRouter entries below claim the defaults, so these do not.
				-->
				<model id="claude-opus-5"
				       label="Claude Opus 5"
				       tier="opus"
				       contextWindow="1000000"
				       maxOutputTokens="128000"/>
				<model id="claude-sonnet-5"
				       label="Claude Sonnet 5"
				       tier="sonnet"
				       contextWindow="1000000"
				       maxOutputTokens="128000"/>
			</models>
		</provider>

		<!--
		  cache="implicit": the provider caches long prefixes on its own. No
		  cache directive is sent upstream; hits are read back from the usage
		  block and reported to Desktop as cache_read_input_tokens.
		-->
		<provider name="openrouter" kind="openai" cache="implicit">
			<baseURL>https://openrouter.ai/api/v1</baseURL>
			<apiKey>${OPENROUTER_API_KEY}</apiKey>
			<headers>
				<header name="HTTP-Referer">https://github.com/wow-look-at-my/liberated-claude</header>
				<header name="X-Title">Liberated Claude</header>
			</headers>
			<models>
				<!--
				  contextWindow values below are OpenRouter's published
				  context_length for each model. The two flash models carry
				  1310720 tokens: more than six times the 200000 a router that
				  clamps every model to Anthropic's ceiling would offer.
				-->
				<model id="z-ai/glm-5.3-flash"
				       label="GLM 5.3 Flash"
				       tier="opus"
				       tierDefault="true"
				       contextWindow="1310720"
				       maxOutputTokens="131072"/>
				<model id="deepseek/deepseek-v4-flash-0731"
				       label="DeepSeek V4 Flash 0731"
				       tier="sonnet"
				       tierDefault="true"
				       contextWindow="1310720"
				       maxOutputTokens="943718"/>
				<model id="z-ai/glm-5.3"
				       label="GLM 5.3"
				       tier="opus"
				       contextWindow="1048576"
				       maxOutputTokens="131072"/>
				<model id="deepseek/deepseek-v4-pro-0813"
				       label="DeepSeek V4 Pro 0813"
				       tier="mythos"
				       tierDefault="true"
				       contextWindow="1048576"
				       maxOutputTokens="943717"/>
				<model id="moonshotai/kimi-k3"
				       label="Kimi K3"
				       tier="haiku"
				       tierDefault="true"
				       contextWindow="1048576"
				       maxOutputTokens="943718"/>
			</models>
		</provider>
	</providers>
</liberatedClaude>
